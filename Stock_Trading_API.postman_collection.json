{
  "info": {
    "name": "Stock Trading App API",
    "description": "Complete API collection for Stock Trading App",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"John Doe\", \"email\": \"john@example.com\", \"password\": \"password123\"}"
            },
            "url": {
              "raw": "http://localhost:5000/api/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"john@example.com\", \"password\": \"password123\"}"
            },
            "url": {
              "raw": "http://localhost:5000/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Stocks",
      "item": [
        {
          "name": "Get All Stocks",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:5000/api/stocks",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "stocks"]
            }
          }
        },
        {
          "name": "Search Stocks",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:5000/api/stocks/search?query=AAPL",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "stocks", "search"],
              "query": [
                {
                  "key": "query",
                  "value": "AAPL"
                }
              ]
            }
          }
        },
        {
          "name": "Get Stock By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:5000/api/stocks/:id",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "stocks", ":id"]
            }
          }
        }
      ]
    },
    {
      "name": "Trading",
      "item": [
        {
          "name": "Buy Stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer YOUR_JWT_TOKEN"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"stockId\": \"stock_id_here\", \"quantity\": 10, \"price\": 150.25}"
            },
            "url": {
              "raw": "http://localhost:5000/api/trades/buy",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "trades", "buy"]
            }
          }
        },
        {
          "name": "Sell Stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer YOUR_JWT_TOKEN"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"stockId\": \"stock_id_here\", \"quantity\": 5, \"price\": 150.25}"
            },
            "url": {
              "raw": "http://localhost:5000/api/trades/sell",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "trades", "sell"]
            }
          }
        },
        {
          "name": "Get Portfolio",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_JWT_TOKEN"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/trades/portfolio",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "trades", "portfolio"]
            }
          }
        },
        {
          "name": "Transaction History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_JWT_TOKEN"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/trades/history",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "trades", "history"]
            }
          }
        }
      ]
    }
  ]
}
